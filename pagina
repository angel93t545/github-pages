5mzb Ft7HRd-AhqUyc-II5mzb jXK9ad oNuCif iCPaDd AnaoJb rxKKvd" data-id="70d0c0333f6c7b07_97"><div jscontroller="fGv1ef" jsname="YWFs"></div><div class="jXK9ad-SmKAyb v7v1sb"><div jsname="B9nUkc" aria-grabbed="false" aria-selected="false" class="T8a1Xd SaaLvd baZpAe baZpAe" jsaction="click:WACf6; dblclick:Tx6ZJf;" aria-label="Texto" role="gridcell"><div jscontroller="FmKeob" jsaction="rcuQ6b:WYd;" data-container-id="70d0c0333f6c7b07_97"></div><div class="BdNftd NUz8T" jsname="p6bZPc" jscontroller="B83o6d" jsaction="mousedown:ylAh2; mousemove:BTghHf; mouseup:NAfnWc;"><div class="j6NFV VIAJYb" data-id="70d0c0333f6c7b07_97" jsmodel="WRX7Cb" jscontroller="Vjf3z" jsaction="rcuQ6b:WYd;XNEatd:MJgihd;McHURe:EqP9ff;mbpntf:VAT5gb;Qo5H5:TW70Hc;qgG8of:wuAb9d;ITIVfe:GZURM;GbFbdd:zkFVCd;vTlt8c:TZYAtb;Vr5S6d:PzOF0e;D9sfK:TRhBMd; blur:fpfTEe; keydown:mAamLc; mousedown:ozHSt; mouseup:p3lcHc"><div jsname="v2VoOd" class="lf5WFf" id="ij8cu70d0c0333f6c7b07_97" contenteditable="false" tabindex="-1" data-gramm_editor="false" role="textbox"><p dir="ltr" role="presentation" class="zfr3Q CDt4Ke " style="line-height: 1.7999999999999998;"><span data-ri="0" data-sc="235" class="C9DxTc " style="color: #ffffff; font-family: Arial; font-size: 20.0px; font-weight: 400; vertical-align: baseline;">Los 18 eventos del FIM Motocross World Championship y los 12 eventos del AMA Motocross Championship consisten de dos carreras de 20 minutos más dos vueltas en cada categoría. Se suman los puntos de ambas mangas para decidir el ganador.</span></p><p dir="ltr" role="presentation" class="zfr3Q CDt4Ke " style="background-color: transparent; border-bottom: none; border-left: none; border-right: none; border-top: none; line-height: 1.7999999999999998; margin-bottom: 0.0pt; margin-top: 0.0pt; padding-bottom: 0.0pt; padding-left: 0.0pt; padding-right: 0.0pt; padding-top: 0.0pt;"><span data-ri="0" data-sc="434" class="C9DxTc " style="color: #ffffff; font-family: Arial; font-size: 20.0px; font-weight: 400; vertical-align: baseline;">El AMA Supercross es diferente. En cada uno de los 17 eventos, que se celebran entre enero y mayo, hay dos mangas con 22 pilotos que se clasifican para el evento principal. La carrera dura 20 minutos más una vuelta en la categoría reina (450 cc). Los pilotos de la clase de 250 cc se dividen entre la Costa Este y Oeste, cada una consta de ocho eventos. Luego se celebra la gran final conjunta en Las Vegas al término de la temporada.</span></p><p dir="ltr" role="presentation" class="zfr3Q CDt4Ke " style="background-color: transparent; border-bottom: none; border-left: none; border-right: none; border-top: none; line-height: 1.7999999999999998; margin-bottom: 0.0pt; margin-top: 0.0pt; padding-bottom: 0.0pt; padding-left: 0.0pt; padding-right: 0.0pt; padding-top: 0.0pt;"><span data-ri="0" data-sc="373" class="C9DxTc " style="color: #ffffff; font-family: Arial; font-size: 20.0px; font-weight: 400; vertical-align: baseline;">En el FMX hay dos tipos de eventos: Big Air y Freestyle Motocross. En el primero un panel de jueces decide sobre los siguientes parámetros: estilo, truco, dificultad y originalidad. La puntuación máxima es 100. En el Freestyle Motocross también se puntúa hasta 100, en esta especialidad los jueces valoran sobre todo la dificultad de los trucos y la variedad de los saltos.</span></p><p dir="ltr" role="presentation" class="zfr3Q CDt4Ke " style="text-align: center;"><br data-ri="0" data-sc="1" style=""></p></div><div jsname="LwH6nd" class="n5vXWb" style="display:none"><p class="zfr3Q CDt4Ke" jsname="D8QWve">Haz clic para editar el texto</p></div><div jsname="t8SdHb" jscontroller="BYrVPe" jsaction="mousedown:npT2md(preventDefault=true);qUuEUd:npT2md;" data-direction="row"></div></div><div class="czDCbb"><div class="WbdZhc"></div><div class="WbdZhc"></div><div class="WbdZhc"></div><div class="WbdZhc"></div><div class="WbdZhc"></div><div class="WbdZhc"></div><div class="WbdZhc"></div><div class="WbdZhc"></div><div class="WbdZhc"></div><div clas