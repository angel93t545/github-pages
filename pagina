e que ver con el rendimiento y es juzgado por un panel que busca los mejores trucos.\nBig Air es una versión más nueva de Freestyle. También se conoce como el mejor truco, y es donde cada piloto obtiene dos saltos desde una rampa de tierra. Los jueces evalúan una vez más el salto de cada ciclista y lo puntúan sobre 100, solo se cuenta su puntuación más alta y gana el total más alto.p\n"}],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["363e8e9d9d9d5282_94","363e8e9d9d9d5282_98","363e8e9d9d9d5282_97","363e8e9d9d9d5282_96"]],{"ty":"as","st":"paragraph","si":140,"ei":140,"sm":{"ps_ls":1.5,"ps_ls_i":false}}],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["363e8e9d9d9d5282_94","363e8e9d9d9d5282_98","363e8e9d9d9d5282_97","363e8e9d9d9d5282_96"]],{"ty":"as","st":"paragraph","si":441,"ei":441,"sm":{"ps_ls":1.5,"ps_ls_i":false,"ps_sb":0,"ps_sb_i":false}}],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["363e8e9d9d9d5282_94","363e8e9d9d9d5282_98","363e8e9d9d9d5282_97","363e8e9d9d9d5282_96"]],{"ty":"as","st":"text","si":1,"ei":441,"sm":{"ts_ff":"Arial","ts_ff_i":false,"ts_fgc2":{"clr_type":0,"hclr_color":"#000000"},"ts_fgc2_i":false,"ts_fs":15,"ts_fs_i":false}}],["addGroup","INITIAL_PAGE.btcy0xrfihr4","363e8e9d9d9d5282_94",6,"363e8e9d9d9d5282_102",3,[]],["addRow","INITIAL_PAGE.btcy0xrfihr4","363e8e9d9d9d5282_94","363e8e9d9d9d5282_102","363e8e9d9d9d5282_101",0,0],["addLayoutTile","INITIAL_PAGE.btcy0xrfihr4","363e8e9d9d9d5282_94","363e8e9d9d9d5282_102","363e8e9d9d9d5282_101",0,0,"363e8e9d9d9d5282_100",3,1,0,"role_text",[]],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["363e8e9d9d9d5282_94","363e8e9d9d9d5282_102","363e8e9d9d9d5282_101","363e8e9d9d9d5282_100"]],{"ty":"is","ibi":1,"s":"Supermoto es una de las disciplinas más nuevas del motocross, a pesar de que ha tenido una serie mundial durante más de 20 años.\nAl igual que Rallycross, supermoto tiene un poco de todo. Las motos son máquinas todoterreno, pero tienden a usar neumáticos lisos; esto puede cambiar según el clima y el tipo de pista.\nLas pistas que se usan en supermoto abarcan tres deportes diferentes, utilizan los saltos y obstáculos del motocross, el asfalto pavimentado de las carreras en carretera y la tierra compactada que generalmente se ve en las carreras de pista plana.\n\n"}],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["363e8e9d9d9d5282_94","363e8e9d9d9d5282_102","363e8e9d9d9d5282_101","363e8e9d9d9d5282_100"]],{"ty":"as","st":"paragraph","si":129,"ei":129,"sm":{"ps_ls":1.5,"ps_ls_i":false}}],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["363e8e9d9d9d5282_94","363e8e9d9d9d5282_102","363e8e9d9d9d5282_101","363e8e9d9d9d5282_100"]],{"ty":"as","st":"paragraph","si":315,"ei":315,"sm":{"ps_ls":1.5,"ps_ls_i":false,"ps_sb":0,"ps_sb_i":false}}],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["363e8e9d9d9d5282_94","363e8e9d9d9d5282_102","363e8e9d9d9d5282_101","363e8e9d9d9d5282_100"]],{"ty":"as","st":"paragraph","si":563,"ei":563,"sm":{"ps_ls":1.5,"ps_ls_i":false,"ps_sb":0,"ps_sb_i":false}}],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["363e8e9d9d9d5282_94","363e8e9d9d9d5282_102","363e8e9d9d9d5282_101","363e8e9d9d9d5282_100"]],{"ty":"as","st":"paragraph","si":564,"ei":564,"sm":{"ps_hd":2,"ps_hdid":"h.wf1igmipd3j","ps_ls":1.15,"ps_ls_i":false}}],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["363e8e9d9d9d5282_94","363e8e9d9d9d5282_102","363e8e9d9d9d5282_101","363e8e9d9d9d5282_100"]],{"ty":"as","st":"text","si":1,"ei":563,"sm":{"ts_bd":true,"ts_bd_i":true,"ts_ff":"Arial","ts_ff_i":false,"ts_fgc2":{"clr_type":0,"hclr_color":"#000000"},"ts_fgc2_i":false,"ts_fs":15,"ts_fs_i":false}}],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["363e8e9d9d9d5282_94","363e8e9d9d9d5282_102","363e8e9d9d9d5282_101","363e8e9d9d9d5282_100"]],{"ty":"as","st":"text","si":564,"ei":564,"sm":{"ts_bd":true,"ts_bd_i