 reina (450 cc). Los pilotos de la clase de 250 cc se dividen entre la Costa Este y Oeste, cada una consta de ocho eventos. Luego se celebra la gran final conjunta en Las Vegas al término de la temporada.\nEn el FMX hay dos tipos de eventos: Big Air y Freestyle Motocross. En el primero un panel de jueces decide sobre los siguientes parámetros: estilo, truco, dificultad y originalidad. La puntuación máxima es 100. En el Freestyle Motocross también se puntúa hasta 100, en esta especialidad los jueces valoran sobre todo la dificultad de los trucos y la variedad de los saltos.\n"}],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["70d0c0333f6c7b07_76","70d0c0333f6c7b07_91","70d0c0333f6c7b07_96","70d0c0333f6c7b07_97"]],{"ty":"as","st":"paragraph","si":236,"ei":236,"sm":{"ps_al":1,"ps_al_i":true,"ps_ls":1.5,"ps_ls_i":false,"ps_lslm":1,"ps_lslm_i":true,"ps_sm":1,"ps_sm_i":true}}],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["70d0c0333f6c7b07_76","70d0c0333f6c7b07_91","70d0c0333f6c7b07_96","70d0c0333f6c7b07_97"]],{"ty":"as","st":"paragraph","si":671,"ei":671,"sm":{"ps_al":1,"ps_al_i":true,"ps_ls":1.5,"ps_ls_i":false,"ps_lslm":1,"ps_lslm_i":true,"ps_sb":0,"ps_sb_i":false,"ps_sm":1,"ps_sm_i":true}}],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["70d0c0333f6c7b07_76","70d0c0333f6c7b07_91","70d0c0333f6c7b07_96","70d0c0333f6c7b07_97"]],{"ty":"as","st":"paragraph","si":1045,"ei":1045,"sm":{"ps_al":1,"ps_al_i":true,"ps_ls":1.5,"ps_ls_i":false,"ps_lslm":1,"ps_lslm_i":true,"ps_sb":0,"ps_sb_i":false,"ps_sm":1,"ps_sm_i":true}}],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["70d0c0333f6c7b07_76","70d0c0333f6c7b07_91","70d0c0333f6c7b07_96","70d0c0333f6c7b07_97"]],{"ty":"as","st":"paragraph","si":1046,"ei":1046,"sm":{"ps_al":1,"ps_al_i":false,"ps_lslm":1,"ps_lslm_i":true,"ps_sm":1,"ps_sm_i":true}}],["docs-nestedModel",["atari-textTile","INITIAL_PAGE.btcy0xrfihr4",["70d0c0333f6c7b07_76","70d0c0333f6c7b07_91"